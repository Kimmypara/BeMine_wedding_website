CREATE TABLE users (
 user_id int PRIMARY KEY AUTO_INCREMENT,
 email VARCHAR (255),
 password_hash VARCHAR (255),
 first_name VARCHAR(255),
 last_name VARCHAR(255),
 created_at DATETIME,
 role_id int,
 FOREIGN KEY (role_id) REFERENCES role(role_id)
);

CREATE TABLE role(
    role_id int PRIMARY KEY AUTO_INCREMENT ,
    role_name VARCHAR(100)
    );
    
CREATE TABLE wedding_plan(
	wedding_plan_id int PRIMARY KEY AUTO_INCREMENT,
    user_id int,
    FOREIGN KEY (user_id) REFERENCES users(user_id),
    user_nickname VARCHAR(100),
    partner_nickname VARCHAR(100),
    wedding_date DATE ,
    guest_count int,
    budget DECIMAL ,
    created_at DATETIME
);

CREATE TABLE our_wedding(
our_wedding_id int PRIMARY KEY AUTO_INCREMENT ,
    profile_image VARCHAR(500),
    wedding_plan_id int,
    FOREIGN KEY (wedding_plan_id) REFERENCES wedding_plan(wedding_plan_id) 
);

CREATE TABLE category(
category_id int PRIMARY KEY AUTO_INCREMENT ,
    category_name VARCHAR(255)
);

CREATE TABLE task(
    task_id int PRIMARY KEY AUTO_INCREMENT ,
    category_id int ,
    FOREIGN KEY (category_id) REFERENCES category(category_id),
    task_name VARCHAR(255)
    );
    
 CREATE TABLE wedding_plan_task (
 wedding_plan_task_id int PRIMARY KEY AUTO_INCREMENT ,
  wedding_plan_id int,
     FOREIGN KEY (wedding_plan_id) REFERENCES wedding_plan(wedding_plan_id),
   task_id int,
     FOREIGN KEY (task_id) REFERENCES task(task_id),
     is_selected BOOLEAN ,
     is_completed BOOLEAN ,
     is_completed DATETIME
 );  
 
 CREATE TABLE vendor(
     vendor_id int PRIMARY KEY AUTO_INCREMENT ,
     vendor_name VARCHAR(500),
     category_id int,
     FOREIGN KEY (category_id) REFERENCES category(category_id),
      user_id int,
     FOREIGN KEY (user_id) REFERENCES users(user_id),
     price_min DECIMAL,
     price_max DECIMAL
     );
     
     CREATE TABLE booking(
     booking_id int PRIMARY KEY AUTO_INCREMENT ,
     wedding_plan_id int,
     FOREIGN KEY (wedding_plan_id) REFERENCES wedding_plan(wedding_plan_id),   
     vendor_id int,
     FOREIGN KEY (vendor_id) REFERENCES vendor(vendor_id),   
     task_id int,
     FOREIGN KEY (task_id) REFERENCES task(task_id),
     booking_status_id int,
     FOREIGN KEY (booking_status_id) REFERENCES booking_status(booking_status_id),  
      booked_price DECIMAL,
      booked_at DATETIME   
     );
     
     CREATE TABLE booking_status(
     booking_status_id int PRIMARY KEY AUTO_INCREMENT,
       booking_status_name VARCHAR(100)  
     );
     
     CREATE TABLE guest(
     guest_id int PRIMARY KEY AUTO_INCREMENT ,
        wedding_plan_id int,
     FOREIGN KEY (wedding_plan_id) REFERENCES wedding_plan(wedding_plan_id), 
     email VARCHAR(255),
      guest_name VARCHAR(255),
     guest_surname VARCHAR(255),
      rsvp_status VARCHAR(100)   
     );
     
     CREATE TABLE reset_password(
     reset_password_id int PRIMARY KEY AUTO_INCREMENT ,
      user_id int,
     FOREIGN KEY (user_id) REFERENCES users(user_id), 
      reset_token VARCHAR(255),
       expires_at DATETIME  
     );
     
   CREATE TABLE settings_theme(
       settings_theme_id int PRIMARY KEY AUTO_INCREMENT ,
     user_id int,
     FOREIGN KEY (user_id) REFERENCES users(user_id),
       dark_mode BOOLEAN
       );
       
       create table chat(
       chat_id int PRIMARY KEY AUTO_INCREMENT ,
       is_group BOOLEAN,
       chat_name VARCHAR(500)    
       );
       
       CREATE TABLE chat_member(
       chat_member_id int PRIMARY KEY AUTO_INCREMENT,
        chat_id int,
     FOREIGN KEY (chat_id) REFERENCES chat(chat_id), 
        user_id int,
     FOREIGN KEY (user_id) REFERENCES users(user_id)    
       );
       
       CREATE TABLE chat_message(
       chat_message_id int PRIMARY KEY AUTO_INCREMENT,
        chat_id int,
     FOREIGN KEY (chat_id) REFERENCES chat(chat_id),
            sender_id int,
     FOREIGN KEY (sender_id) REFERENCES users(user_id),  
     message_content VARCHAR,
       sent_at DATETIME    
       );